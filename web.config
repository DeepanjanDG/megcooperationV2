<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <httpErrors errorMode="Custom">
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" prefixLanguageFilePath="" path="404.html" responseMode="File" />
        </httpErrors>

        <directoryBrowse enabled="false" />
        <security>
            <requestFiltering removeServerHeader="true">
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment=".vscode" />
                    <add segment="node_modules" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                </fileExtensions>
                <!-- Static site: only GET and HEAD are allowed -->
                <verbs allowUnlisted="false">
                    <add verb="GET" allowed="true" />
                    <add verb="HEAD" allowed="true" />
                </verbs>
            </requestFiltering>
        </security>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
                <add name="Cross-Origin-Opener-Policy" value="same-origin" />
                <add name="X-Permitted-Cross-Domain-Policies" value="none" />
                <!-- Allowed outside hosts: Bhashini translation plugin, OpenStreetMap map on Contact Us. No inline scripts. -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://translation-plugin.bhashini.co.in; style-src 'self' 'unsafe-inline' https://translation-plugin.bhashini.co.in; img-src 'self' data: https://translation-plugin.bhashini.co.in; font-src 'self'; connect-src 'self' https://translation-plugin.bhashini.co.in; frame-src https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; upgrade-insecure-requests" />
            </customHeaders>
        </httpProtocol>

        <urlCompression doStaticCompression="true" doDynamicCompression="false" />
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>

        <rewrite>
            <rules>
                <rule name="HTTPS_REDIRECT" enabled="true" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
